<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="output-container" style="margin-bottom: 8; padding-left: 6; padding-right: 6; padding-top: 4; padding-bottom: 4; background-color: rgba(0, 0, 0, 0.6);">
        <ui:Label name="output-name" text="Title" style="font-size: 13; color: rgb(255, 230, 77); -unity-font-style-and-weight: bold; margin-bottom: 2;" />
        <ui:Label name="output-content" text="Content" style="font-size: 12; color: white; white-space: normal;" />
    </ui:VisualElement>
</ui:UXML>
